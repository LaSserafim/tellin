{
  "name": "tellin-crypto-terminal",
  "version": "1.0.0",
  "description": "Institutional Crypto Quantitative, Geopolitical & Analytical Terminal",
  "main": "backend/main.py",
  "scripts": {
    "start": "python3 -m uvicorn main:app --app-dir backend --host 0.0.0.0 --port 3001",
    "dev": "python3 -m uvicorn main:app --app-dir backend --host 0.0.0.0 --port 3001 --reload --reload-dir backend",
    "serve": "./run.sh",
    "test": "python3 -c \"import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:3001/api/health').read().decode())\""
  },
  "keywords": [
    "crypto",
    "quantitative",
    "terminal",
    "tradingview",
    "deepseek",
    "screener",
    "drawdown"
  ],
